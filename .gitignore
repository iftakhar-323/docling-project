venv/
__pycache__/
*.pyc
.env

# Inputs (large binary originals) — keep them out of the repo
input_docs/

# Only commit README.md inside output_md; everything else (combined.md,
# per-file .md, the shared all_images/ folder) is regenerated by convert.py
# and is intentionally untracked.
output_md/combined.md
output_md/all_images/
output_md/.staging/
output_md/*.md
!output_md/README.md

# Puku editor local state
.puku/
